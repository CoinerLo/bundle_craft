{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "./lib/index.d.ts",
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "./library.d.ts"
  },
  "compiler": {
    "tsconfigFilePath": "./tsconfig.json"
  },
  "apiReport": {
    "enabled": false
  },
  "docModel": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  }
}
